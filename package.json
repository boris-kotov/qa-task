{
  "name": "toolshop-qa-task",
  "private": true,
  "version": "0.1.0",
  "description": "QA assessment of Practice Software Testing (Toolshop) \u2014 local instance only",
  "scripts": {
    "test": "playwright test",
    "posttest": "node scripts/check-expected-failures.mjs",
    "test:report": "FULL_EVIDENCE=true RESET_DB=true npm test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui-chromium",
    "test:stability": "playwright test --repeat-each=3 --workers=4",
    "report": "playwright show-report reports/html",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run guard",
    "guard": "node scripts/guard-repo.mjs --all",
    "sessions:export": "bash scripts/export-sessions.sh",
    "sessions:redact": "bash scripts/export-sessions.sh --redact-only",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:check-failures": "node scripts/check-expected-failures.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-plugin-playwright": "2.12.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "zod": "4.6.7"
  }
}
