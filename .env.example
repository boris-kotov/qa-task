# Copy to .env and adjust if needed. Only localhost targets are accepted (validated in src/config/env.ts).
BASE_URL=http://localhost:4200
API_URL=http://localhost:8091

# Path to the local Toolshop clone (used by global-setup for optional DB reset)
APP_DIR=../toolshop-app
# true -> run `php artisan migrate:fresh --seed` once before the test run
RESET_DB=false

# Password used for users created by tests via API (Toolshop demo credentials are public, these are ours)
TEST_USER_PASSWORD=ChangeMe-Str0ng!pass

# Seeded demo accounts (public, from Toolshop README) — used only where a test explicitly needs them
DEMO_CUSTOMER_EMAIL=customer@practicesoftwaretesting.com
DEMO_CUSTOMER_PASSWORD=welcome01
