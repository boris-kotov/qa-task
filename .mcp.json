{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--isolated",
        "--allowed-origins",
        "http://localhost:4200;http://localhost:8091",
        "--output-dir",
        ".playwright-mcp"
      ]
    }
  }
}
